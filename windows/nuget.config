<?xml version="1.0" encoding="utf-8"?>
<!-- Only the public nuget.org feed, regardless of feeds configured on the machine. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
