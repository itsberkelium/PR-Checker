<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything except the UI: API client, rules, notifications logic, storage.
       Cross-platform so it builds and tests on any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PRChecker.Core</RootNamespace>
    <!-- The app is published with Native AOT; this turns on the trimming/AOT analyzers here too. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PRChecker.Core.Tests" />
  </ItemGroup>
</Project>
