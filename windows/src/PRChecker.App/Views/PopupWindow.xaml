<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PRChecker.App.Views.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PRChecker.App.Views"
    Title="PR Checker">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
        <SelectorBar x:Name="Tabs" Grid.Row="0" HorizontalAlignment="Center" Margin="0,6,0,4"
                     SelectionChanged="OnTabChanged">
            <SelectorBarItem x:Name="ReviewTab" Text="To review" IsSelected="True" />
            <SelectorBarItem x:Name="MineTab" Text="Mine" />
        </SelectorBar>

        <InfoBar x:Name="NotificationsBlocked" Grid.Row="1" Severity="Warning" IsClosable="False" Margin="8,0,8,4"
                 Title="Notifications are off in Windows Settings" IsOpen="False">
            <InfoBar.ActionButton>
                <HyperlinkButton Content="Open notification settings" Click="OnOpenNotificationSettings" />
            </InfoBar.ActionButton>
        </InfoBar>

        <ListView x:Name="List" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:PrRow">
                    <StackPanel Spacing="3" ToolTipService.ToolTip="{x:Bind Tooltip}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Updated}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ItemsControl ItemsSource="{x:Bind Badges}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:Badge">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" Foreground="{x:Bind Foreground}" />
                                        <TextBlock Text="{x:Bind Text}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{x:Bind Foreground}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="EmptyState" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Visibility="Collapsed">
            <FontIcon x:Name="EmptyIcon" Glyph="&#xE73E;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300" />
            <Button x:Name="EmptyAction" HorizontalAlignment="Center" Content="Open Settings" Click="OnSettings" Visibility="Collapsed" />
        </StackPanel>

        <Border Grid.Row="3" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Padding="12,6" ColumnSpacing="4">
            <FontIcon x:Name="ErrorIcon" Glyph="&#xE7BA;" FontSize="14" Foreground="DarkOrange" Visibility="Collapsed" Margin="0,0,6,0" />
            <TextBlock x:Name="UpdatedText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="RefreshButton" Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Click="OnRefresh"
                    ToolTipService.ToolTip="Refresh (Ctrl+R)">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="R" />
                </Button.KeyboardAccelerators>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource SubtleButtonStyle}" Click="OnSettings" ToolTipService.ToolTip="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>
            <Button Grid.Column="4" Style="{StaticResource SubtleButtonStyle}" Click="OnQuit" ToolTipService.ToolTip="Quit PR Checker">
                <FontIcon Glyph="&#xE7E8;" FontSize="14" />
            </Button>
        </Grid>
    </Grid>
</Window>
