<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PRChecker.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PR Checker Settings">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView x:Name="Navigation" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                    SelectionChanged="OnNavigate">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="GeneralItem" Content="General" Tag="General" Icon="Setting" />
            <NavigationViewItem x:Name="BitbucketItem" Content="Bitbucket" Tag="Bitbucket">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE968;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="AboutItem" Content="About" Tag="About">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE946;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <ScrollViewer Padding="24,16,24,24">
            <Grid MaxWidth="560">
                <!-- General -->
                <StackPanel x:Name="GeneralPage" Spacing="16">
                    <ToggleSwitch x:Name="NotificationsToggle" Header="Notifications" Toggled="OnNotificationsToggled" />
                    <InfoBar x:Name="NotificationsBlocked" Severity="Warning" IsClosable="False" IsOpen="False"
                             Title="Turned off in Windows Settings"
                             Message="Windows is blocking PR Checker's notifications. Turn them on for PR Checker.">
                        <InfoBar.ActionButton>
                            <Button Content="Open notification settings" Click="OnOpenNotificationSettings" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <Button x:Name="TestNotificationButton" Content="Send test notification" Click="OnSendTest" />
                    <ToggleSwitch x:Name="DetailsToggle" Header="Show pull request details in notifications" Toggled="OnDetailsToggled" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Text="Off: notifications don't show titles, names or results, e.g. while screen sharing." />
                    <ToggleSwitch x:Name="OpenAtLoginToggle" Header="Open at login" Toggled="OnOpenAtLoginToggled" />
                    <ComboBox x:Name="RefreshBox" Header="Check every" SelectionChanged="OnRefreshChanged" MinWidth="160" />
                </StackPanel>

                <!-- Bitbucket -->
                <StackPanel x:Name="BitbucketPage" Spacing="16" Visibility="Collapsed">
                    <TextBox x:Name="ServerBox" Header="Server URL" PlaceholderText="https://bitbucket.example.com" />
                    <PasswordBox x:Name="TokenBox" Header="Access token" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Text="Create a token under Profile → Manage account → HTTP access tokens with Read permission. It is stored in Windows Credential Manager and only sent to this server." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ConnectButton" Content="Save &amp; Connect" Style="{StaticResource AccentButtonStyle}" Click="OnConnect" />
                        <Button x:Name="SignOutButton" Content="Sign Out" Click="OnSignOut" />
                        <ProgressRing x:Name="ConnectProgress" Width="20" Height="20" IsActive="False" />
                    </StackPanel>
                    <InfoBar x:Name="ConnectStatus" IsClosable="False" IsOpen="False" />

                    <TextBlock Text="Filters" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                    <ToggleSwitch x:Name="HideDraftsToggle" Header="Hide draft pull requests" Toggled="OnHideDraftsToggled" />
                    <TextBox x:Name="FilterBox" Header="Only these projects/repos" PlaceholderText="All" LostFocus="OnFilterChanged" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Text="Comma-separated project keys or PROJECT/repo-slug, e.g. PROJ, OTHER/my-repo." />
                </StackPanel>

                <!-- About -->
                <StackPanel x:Name="AboutPage" Spacing="16" Visibility="Collapsed">
                    <TextBlock x:Name="VersionText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Check for updates" Click="OnCheckForUpdates" />
                        <TextBlock x:Name="LastCheckText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <HyperlinkButton Content="github.com/itsberkelium/PR-Checker" NavigateUri="https://github.com/itsberkelium/PR-Checker" Padding="0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </NavigationView>
</Window>
